{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bakugan-battle-planet-online",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bakugan-battle-planet-online",
      "database_id": "0db23d77-e217-4d83-999c-06077e827a7f",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MATCHES", "class_name": "MatchRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
